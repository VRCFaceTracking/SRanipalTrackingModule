<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\vive_hmd.png" />
    <EmbeddedResource Include="Assets\vive_hmd.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Remove="Assets\vive_face_tracker.png" />
    <EmbeddedResource Include="Assets\vive_face_tracker.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VRCFaceTracking.SDK">
      <HintPath>../VRCFaceTracking/VRCFaceTracking.SDK/bin/Release/net10.0/VRCFaceTracking.SDK.dll</HintPath>
    </Reference>
    <Reference Include="VRCFaceTracking.Core">
      <HintPath>../VRCFaceTracking/VRCFaceTracking.Core/bin/Release/net10.0/VRCFaceTracking.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
